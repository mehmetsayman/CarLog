# Pinata JWT for pinning record photos to IPFS. Optional: without it the
# app works, but the photo field reports that uploads are not configured.
# Needs the org:files:write scope (app.pinata.cloud > API Keys).
PINATA_JWT=

# Admin screen (/admin) sign-in. Defaults: admin / 0000. The sign-in only opens
# the screen; approving a garage still needs the registry owner's wallet.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. A private Monad testnet RPC for the server's reads. The public one
# allows 15 requests a second; a higher-limit endpoint keeps the buyer pages fast
# when many people open them at once. Browsers always use the public RPC.
MONAD_RPC_URL=
